{
  "name": "friday-edith-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "F.R.I.D.A.Y. & E.D.I.T.H. Dual AI Platform Monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@friday-edith/web",
    "dev:api": "npm run dev --workspace=@friday-edith/api",
    "dev:runner": "npm run start --prefix runner-host/runner-service",
    "build:web": "npm run build --workspace=@friday-edith/web",
    "build:api": "npm run db:validate:mysql && node --check services/api/src/server.js",
    "test:web": "npm run test --workspace=@friday-edith/web",
    "test:api": "npm run test --workspace=@friday-edith/api",
    "test:runner": "npm run test --prefix runner-host/runner-service",
    "test": "npm run test:api && npm run test:web && npm run test:runner",
    "db:seed": "npm run prisma:seed --workspace=@friday-edith/api",
    "db:deploy:sqlite": "npm run prisma:migrate:deploy:sqlite --workspace=@friday-edith/api",
    "db:deploy:mysql": "npm run prisma:migrate:deploy:mysql --workspace=@friday-edith/api",
    "db:validate:mysql": "npm run db:validate:mysql --workspace=@friday-edith/api"
  },
  "keywords": [
    "ai",
    "assistant",
    "ide",
    "autonomous-agent",
    "friday",
    "edith",
    "monorepo"
  ],
  "author": "F.R.I.D.A.Y. + E.D.I.T.H. Core Team",
  "license": "UNLICENSED"
}

