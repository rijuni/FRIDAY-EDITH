# ==============================================================================
# F.R.I.D.A.Y. + E.D.I.T.H. Environment Configuration Baseline
# Blueprint Version: 2.1
# Note: Never commit actual credentials or secrets to source control.
# ==============================================================================

# Application & API Ports (Native Services)
NODE_ENV=development
PORT=3000
API_HOST=localhost
WEB_PORT=5173

# Database Persistence (Prisma)
# Local SQLite baseline for rapid development:
DATABASE_URL="file:./dev.db"
# Canonical Production MySQL target:
# DATABASE_URL="mysql://friday_user:friday_password@localhost:3306/friday_edith_db?schema=public"

# Auth & Security
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_signing_secret
CORS_ORIGIN=http://localhost:5173

# Internal AI Microservices (Private network only - never expose publicly)
FRIDAY_AI_SERVICE_URL=http://localhost:8001
EDITH_ENGINE_SERVICE_URL=http://localhost:8002

# Isolated Runner Host (Restricted VM / low-privilege host)
EDITH_RUNNER_SERVICE_URL=http://localhost:8003
EDITH_RUNNER_SECRET=replace_with_internal_hmac_secret

# AI Provider API Keys (Managed server-side in OS storage / vault)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
