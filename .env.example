# ==============================================================================
# F.R.I.D.A.Y. + E.D.I.T.H. Environment Configuration Baseline
# Blueprint Version: 2.1
# Note: Never commit actual credentials or secrets to source control.
# ==============================================================================

# Application & API Ports (Native Services)
NODE_ENV=development
PORT=3000
API_HOST=localhost
WEB_PORT=5173

# Database Persistence (Prisma ORM - MySQL 8.0 / 8.4 Canonical Engine)
# Development database target (with connection pooling):
DATABASE_URL="mysql://friday_user:replace_with_dev_password@localhost:3306/friday_edith_dev?connection_limit=10&pool_timeout=20"
# Staging database target:
# DATABASE_URL="mysql://friday_staging:replace_with_staging_password@staging-db:3306/friday_edith_staging?connection_limit=15&pool_timeout=20"
# Production database target (separate credentials, TLS required):
# DATABASE_URL="mysql://friday_prod:replace_with_production_password@prod-db:3306/friday_edith_prod?connection_limit=25&pool_timeout=30&sslaccept=strict"

# Auth, Cookies & Session Security
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key_in_production
JWT_ISSUER=friday-edith-api
JWT_AUDIENCE=friday-edith-web
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_COOKIE_NAME=friday_access_token
REFRESH_COOKIE_NAME=friday_refresh_token
CSRF_COOKIE_NAME=friday_csrf_token
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Internal Service-to-Service Auth (Must match across API, friday-ai, edith-engine, runner-service)
INTERNAL_SERVICE_SECRET=replace_with_shared_internal_service_secret
REQUIRE_INTERNAL_AUTH=true
AI_REQUEST_TIMEOUT_MS=30000
AI_STREAM_TIMEOUT_MS=120000

# Internal AI & Runner Microservices (Loopback / private network only - never expose publicly)
FRIDAY_AI_SERVICE_URL=http://127.0.0.1:8001
EDITH_ENGINE_SERVICE_URL=http://127.0.0.1:8002
EDITH_RUNNER_SERVICE_URL=http://127.0.0.1:8003

# Workspace & Runner Path Allowlists (Comma-separated or semicolon-separated roots)
ALLOWED_WORKSPACE_ROOTS=.
RUNNER_ALLOWED_ROOTS=.

# Development Database Seeding (Blocked in production unless ALLOW_PROD_SEED=true)
SEED_ADMIN_PASSWORD=
SEED_DEV_PASSWORD=
ALLOW_PROD_SEED=false

# AI Provider API Keys (Managed server-side in OS storage / vault)
# Use `mock` for visibly simulated local responses, or `auto` to route the
# selected model to the matching configured provider. Missing keys fail closed.
FRIDAY_AI_PROVIDER=mock
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-7-sonnet
GEMINI_MODEL=gemini-2.0-flash
PROVIDER_REQUEST_TIMEOUT_SECONDS=90
MALWARE_SCAN_MODE=off
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

