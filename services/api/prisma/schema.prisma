// ==============================================================================
// F.R.I.D.A.Y. + E.D.I.T.H. Canonical Database Schema
// Blueprint Version: 2.1
// Supported Providers: SQLite (Local Development) & MySQL (Target Production)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Shared Platform Models (Identity, Sessions & Audit)
// ------------------------------------------------------------------------------

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         String        @default("USER") // USER, DEVELOPER, ADMIN
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  providerKeys ProviderKey[]

  // F.R.I.D.A.Y. Relations
  conversations   Conversation[]
  memories        MemoryItem[]
  knowledgeBases  KnowledgeBase[]

  // E.D.I.T.H. Relations
  projects        WorkspaceProject[]
  agentTasks      AgentTask[]

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String?
  resourceType String
  resourceId   String?
  status       String   @default("SUCCESS") // SUCCESS, FAILURE, DENIED
  details      String?  // JSON stringified payload for SQLite/MySQL cross-compatibility
  ip           String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model ProviderKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // openai, anthropic, gemini, custom
  encryptedKey String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ------------------------------------------------------------------------------
// F.R.I.D.A.Y. Models (Conversational AI, Memory & RAG)
// ------------------------------------------------------------------------------

model Conversation {
  id              String        @id @default(cuid())
  title           String        @default("New Conversation")
  userId          String
  projectId       String?
  isPinned        Boolean       @default(false)
  isArchived      Boolean       @default(false)
  modelPreference String?
  systemPrompt    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  attachments     Attachment[]

  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  role             String       // user, assistant, system, tool
  content          String
  reasoningContent String?
  metadata         String?      // JSON stringified metadata (citations, token usage, tool args)
  createdAt        DateTime     @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments      Attachment[]

  @@index([conversationId])
}

model Attachment {
  id             String        @id @default(cuid())
  conversationId String
  messageId      String?
  filename       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  parsedContent  String?
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
}

model MemoryItem {
  id                   String        @id @default(cuid())
  userId               String
  category             String        // user_preference, project_context, coding_style, personal_fact
  content              String
  confidence           Float         @default(1.0)
  sourceConversationId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model KnowledgeBase {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]

  @@index([userId])
}

model DocumentChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  title           String?
  content         String
  tokenCount      Int           @default(0)
  chunkIndex      Int           @default(0)
  metadata        String?       // JSON stringified chunk properties
  createdAt       DateTime      @default(now())

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

// ------------------------------------------------------------------------------
// E.D.I.T.H. Models (Developer IDE & Autonomous Agent)
// ------------------------------------------------------------------------------

model WorkspaceProject {
  id            String      @id @default(cuid())
  userId        String
  name          String
  repoUrl       String?
  localPath     String
  defaultBranch String      @default("main")
  settings      String?     // JSON stringified settings (build commands, runner preferences)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentTasks    AgentTask[]

  @@index([userId])
}

model AgentTask {
  id            String             @id @default(cuid())
  projectId     String
  userId        String
  prompt        String
  status        String             @default("QUEUED") // QUEUED, RUNNING, WAITING_APPROVAL, SUCCEEDED, FAILED, CANCELLED, TIMED_OUT
  plan          String?            // JSON stringified execution plan
  resultSummary String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  project       WorkspaceProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoints   Checkpoint[]
  approvals     CommandApproval[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Checkpoint {
  id           String    @id @default(cuid())
  taskId       String
  snapshotHash String
  description  String
  filesChanged String?   // JSON stringified list of modified files & unified diffs
  createdAt    DateTime  @default(now())

  task         AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model CommandApproval {
  id               String    @id @default(cuid())
  taskId           String
  command          String
  riskTier         String    // READ_ONLY, SAFE_EDIT, DESTRUCTIVE_COMMAND, NETWORK_ACCESS, GIT_PUSH
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  task             AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}
