// ==============================================================================
// F.R.I.D.A.Y. + E.D.I.T.H. Canonical Database Schema (MySQL 8.0 / 8.4)
// Sole authoritative schema for development, staging, and production environments.
// Uses @db.Text and @db.LongText to support large text payloads and JSON structures.
// Verified by: npm run db:validate:mysql --workspace=@friday-edith/api
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String        @db.Text
  role         String        @default("USER") // USER, DEVELOPER, ADMIN
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  providerKeys   ProviderKey[]
  conversations  Conversation[]
  memories       MemoryItem[]
  knowledgeBases KnowledgeBase[]
  projects       WorkspaceProject[]
  agentTasks     AgentTask[]

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?  @db.Text
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String?
  resourceType String
  resourceId   String?
  status       String   @default("SUCCESS")
  details      String?  @db.LongText
  ip           String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model ProviderKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String   @db.Text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id              String        @id @default(cuid())
  title           String        @default("New Conversation")
  userId          String
  projectId       String?
  isPinned        Boolean       @default(false)
  isArchived      Boolean       @default(false)
  modelPreference String?
  systemPrompt    String?       @db.LongText
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  attachments     Attachment[]

  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  role             String
  content          String       @db.LongText
  reasoningContent String?      @db.LongText
  metadata         String?      @db.LongText
  createdAt        DateTime     @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments      Attachment[]

  @@index([conversationId])
}

model Attachment {
  id             String        @id @default(cuid())
  conversationId String
  messageId      String?
  filename       String
  mimeType       String
  sizeBytes      Int
  storagePath    String        @db.Text
  parsedContent  String?       @db.LongText
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
}

model MemoryItem {
  id                   String   @id @default(cuid())
  userId               String
  category             String
  content              String   @db.LongText
  confidence           Float    @default(1.0)
  sourceConversationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model KnowledgeBase {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?         @db.Text
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]

  @@index([userId])
}

model DocumentChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  title           String?
  content         String        @db.LongText
  tokenCount      Int           @default(0)
  chunkIndex      Int           @default(0)
  metadata        String?       @db.LongText
  createdAt       DateTime      @default(now())

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

model WorkspaceProject {
  id            String      @id @default(cuid())
  userId        String
  name          String
  repoUrl       String?     @db.Text
  localPath     String      @db.Text
  defaultBranch String      @default("main")
  settings      String?     @db.LongText
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentTasks    AgentTask[]

  @@index([userId])
}

model AgentTask {
  id            String            @id @default(cuid())
  projectId     String
  userId        String
  prompt        String            @db.LongText
  status        String            @default("QUEUED")
  plan          String?           @db.LongText
  resultSummary String?           @db.LongText
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  project       WorkspaceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoints   Checkpoint[]
  approvals     CommandApproval[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Checkpoint {
  id           String    @id @default(cuid())
  taskId       String
  snapshotHash String
  description  String    @db.Text
  filesChanged String?   @db.LongText
  createdAt    DateTime  @default(now())

  task         AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model CommandApproval {
  id               String    @id @default(cuid())
  taskId           String
  command          String    @db.Text
  riskTier         String
  status           String    @default("PENDING")
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  task             AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

